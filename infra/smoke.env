# TEST-ONLY credentials for the docker smoke stack (throwaway local containers). NEVER reuse anywhere real.
# Values containing $ are single-quoted so compose does not interpolate them.
POSTGRES_USER=roi_ci
POSTGRES_PASSWORD=roi_ci_test_only
POSTGRES_DB=roi_hunter_ci

ENV=staging
DATA_SOURCE=redshift
WAREHOUSE_DRIVER=postgres
WAREHOUSE_SSL=false
REDSHIFT_HOST=warehouse
REDSHIFT_PORT=5432
REDSHIFT_DB=roi_hunter_ci
REDSHIFT_USER=roi_ci
REDSHIFT_PASSWORD=roi_ci_test_only
APP_AUTH_METHOD=basic
APP_AUTH_BASIC_USER=smoke
APP_AUTH_BASIC_PASSWORD_HASH='$2b$12$dHX7aVhzYF4xVhEnp8hFwO84iqDbDQem1ipqp0IabPp1Akta5utlK'
APP_SECRET_KEY=smoke-test-only-secret-key-0123456789abcdef
CORS_ORIGINS=http://localhost:3300
ALLOWED_HOSTS=backend,localhost,127.0.0.1

# frontend (server-side proxy credentials + dashboard login)
BACKEND_URL=http://backend:8000
BACKEND_BASIC_USER=smoke
BACKEND_BASIC_PASSWORD=smoke-api-password
UI_BASIC_USER=smoke
UI_BASIC_PASSWORD_SCRYPT=784cb679cd1145ebc1155e4fbda1184f:5c0cf7dc46d595a89c3243702f62bfb2fd57d77d403ee7bbb8adde6bc7c377ea

# seed job
TEST_PG_HOST=warehouse
TEST_PG_PORT=5432
TEST_PG_DB=roi_hunter_ci
TEST_PG_USER=roi_ci
TEST_PG_PASSWORD=roi_ci_test_only
TEST_PG_DSN=host=warehouse port=5432 dbname=roi_hunter_ci user=roi_ci password=roi_ci_test_only
