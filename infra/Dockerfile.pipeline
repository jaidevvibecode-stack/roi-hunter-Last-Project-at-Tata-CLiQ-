# Daily pipeline (scheduler + ingestion + dbt). Production target: Redshift.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app DBT_PROFILES_DIR=/app/transform
WORKDIR /app
RUN useradd --system --uid 10001 --create-home app

COPY pyproject.toml scripts/print_requirements.py ./
RUN python print_requirements.py pipeline > /tmp/req.txt && pip install --no-cache-dir -r /tmp/req.txt \
    && rm -f /tmp/req.txt pyproject.toml print_requirements.py

COPY ingestion ./ingestion
COPY pipeline ./pipeline
COPY config ./config
COPY transform ./transform
# The example profile only contains env_var() references — credentials arrive via environment / secret manager.
RUN cp transform/profiles.yml.example transform/profiles.yml \
    && chown -R app:app /app && su app -c "cd /app/transform && dbt deps"

USER app
# Healthy while the scheduler heartbeat is fresh (written every 30s).
HEALTHCHECK --interval=60s --timeout=5s --start-period=30s --retries=3 \
  CMD python -c "import os,time,sys; p=os.environ.get('SCHEDULER_HEARTBEAT','/tmp/scheduler.heartbeat'); sys.exit(0 if time.time()-os.path.getmtime(p) < 120 else 1)"
CMD ["python", "-m", "pipeline.scheduler"]
