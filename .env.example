# ─── Meta ───────────────────────────────────────────────────────────────────
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_BUSINESS_ID=
# Comma-separated list of ad account IDs, e.g. act_1234567890,act_9876543210
META_AD_ACCOUNT_IDS=
# Comma-separated catalog IDs
META_CATALOG_IDS=
# Pin to a specific Graph API version, e.g. v22.0
META_API_VERSION=v22.0

# ─── Mixpanel ────────────────────────────────────────────────────────────────
MIXPANEL_PROJECT_ID=
MIXPANEL_SERVICE_ACCOUNT_USER=
MIXPANEL_SERVICE_ACCOUNT_SECRET=
# US, EU, or IN
MIXPANEL_REGION=US

# ─── Redshift ────────────────────────────────────────────────────────────────
REDSHIFT_HOST=
REDSHIFT_PORT=5439
REDSHIFT_DB=
REDSHIFT_USER=
REDSHIFT_PASSWORD=
# IAM role ARN for S3 COPY, e.g. arn:aws:iam::123456789012:role/RedshiftS3CopyRole
REDSHIFT_IAM_ROLE_ARN=

# ─── S3 ──────────────────────────────────────────────────────────────────────
S3_RAW_BUCKET=
S3_RAW_PREFIX=roi-hunter/raw
AWS_REGION=ap-south-1

# ─── Reporting ────────────────────────────────────────────────────────────────
# ISO 4217 currency code, e.g. INR
REPORTING_CURRENCY=INR
# Timezone for report_date derivation (ad account tz), e.g. Asia/Kolkata
REPORTING_TZ=Asia/Kolkata
# Default attribution model: M1, M2, M3, or M4
DEFAULT_ATTRIBUTION_MODEL=M1
# Default lookback window in days
DEFAULT_LOOKBACK_DAYS=7

# ─── App auth ─────────────────────────────────────────────────────────────────
# Set method to: basic | none (none = ENV=local only)
APP_AUTH_METHOD=none   # none | basic (none only allowed when ENV=local)
APP_AUTH_GOOGLE_CLIENT_ID=
APP_AUTH_GOOGLE_CLIENT_SECRET=
APP_AUTH_BASIC_USER=
APP_AUTH_BASIC_PASSWORD_HASH=
APP_SECRET_KEY=

# ─── Alerts ───────────────────────────────────────────────────────────────────
ALERT_SLACK_WEBHOOK=
ALERT_EMAIL_TO=

# ─── Backend runtime & security (see SECURITY.md) ────────────────────────────
# local | staging | prod  — anything but "local" FAILS CLOSED unless auth/CORS/secret are configured
ENV=local
# demo = clearly-labelled synthetic data (local only) | redshift = real marts
DATA_SOURCE=demo
# Generate bcrypt hash:  python -c "from backend.core.auth import hash_password as h; print(h('...'))"
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
RATE_LIMIT_PER_MINUTE=240
EXPORT_MAX_ROWS=100000
STATEMENT_TIMEOUT_MS=30000

# ─── Added with the pipeline / hardening work ─────────────────────────────────
# Meta conversion attribution: default = the ad account's own (unified) setting == what Ads Manager shows.
# To pin windows instead: META_USE_UNIFIED_ATTRIBUTION=false and META_ATTRIBUTION_WINDOWS=7d_click  (verify in spike P0.3)
META_USE_UNIFIED_ATTRIBUTION=true
META_ATTRIBUTION_WINDOWS=

# API: Redshift is production. WAREHOUSE_DRIVER=postgres is ONLY for the CI/docker stand-in (refused in ENV=prod).
WAREHOUSE_DRIVER=redshift
WAREHOUSE_SSL=true
# Honour X-Forwarded-For for per-client rate limiting ONLY when a trusted proxy sets it
TRUST_FORWARDED_FOR=false

# Dashboard (frontend/.env.local, server-only): see frontend/.env.local.example
#   BACKEND_URL, BACKEND_BASIC_USER, BACKEND_BASIC_PASSWORD, UI_BASIC_USER, UI_BASIC_PASSWORD_SCRYPT

# Pipeline scheduler
RUN_AT=06:30
