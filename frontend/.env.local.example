# ── Server-only (never prefix with NEXT_PUBLIC_) ──────────────────────────────
# Where the FastAPI backend lives, and the credentials the server-side proxy uses to call it
BACKEND_URL=http://127.0.0.1:8000
BACKEND_BASIC_USER=
BACKEND_BASIC_PASSWORD=

# Dashboard login (basic auth). Generate the hash:  node scripts/hash-ui-password.mjs 'a strong password'
# In production the app returns 503 unless these are set (or UI_AUTH_DISABLED=true is set explicitly — not advised).
UI_BASIC_USER=
UI_BASIC_PASSWORD_SCRYPT=
# UI_AUTH_DISABLED=true
